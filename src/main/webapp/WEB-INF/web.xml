<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
   version="4.0">
    
    <servlet>
        <servlet-name>CartServlet</servlet-name>
        <servlet-class>com.mycompany.muahang.resources.CartServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>CartServlet</servlet-name>
        <url-pattern>/CartServlet</url-pattern>
    </servlet-mapping>    
 
    <servlet>
        <servlet-name>CartActionServlet</servlet-name>
        <servlet-class>com.mycompany.muahang.resources.CartActionServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>CartActionServlet</servlet-name>
        <url-pattern>/CartActionServlet</url-pattern>
    </servlet-mapping>
      
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
